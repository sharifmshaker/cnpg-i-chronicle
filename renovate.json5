{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommitTypeAll(chore)',
  ],
  // No automerge. Pull requests into main need an approving review, which
  // Renovate cannot give itself, so every update is approved by hand.
  //
  // A small project maintained a few hours a month. Batching keeps the PR
  // volume to something reviewable rather than one PR per module bump.
  schedule: ['before 6am on the first day of the month'],
  packageRules: [
    {
      description: 'Go module updates travel together.',
      matchManagers: ['gomod'],
      groupName: 'go modules',
    },
    {
      description: 'CloudNativePG APIs and the CNPG-I protocol gate compatibility, so they get a pull request of their own rather than riding along with other modules.',
      matchPackageNames: [
        'github.com/cloudnative-pg/**',
      ],
      groupName: 'cloudnative-pg',
    },
    {
      description: 'The Go toolchain in go.mod is a deliberate choice, not a dependency.',
      matchManagers: ['gomod'],
      matchDepTypes: ['golang'],
      enabled: false,
    },
  ],
}
