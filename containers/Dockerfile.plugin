# syntax=docker/dockerfile:1

# Requires BuildKit (docker buildx). The cache mounts are what make iteration
# bearable: every build otherwise runs in a fresh container with no Go build
# cache, so the whole dependency graph — cel-go, controller-runtime, the
# Kubernetes libraries — recompiles from source each time. Only the module
# download is a cached layer, and that is not where the time goes.
# The exact patch, matching the go line in go.mod, so a release is built with
# the same Go that CI tests with. Renovate updates both in one pull request.
FROM golang:1.26.4 AS builder
WORKDIR /workspace

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY cmd/ cmd/
COPY api/ api/
COPY internal/ internal/

ARG TARGETOS
ARG TARGETARCH
# Reported to the operator and recorded in every snapshot. The release workflow
# passes the tag; a local build reports "dev".
ARG VERSION=dev
# No -a: CGO_ENABLED=0 already produces a static binary, and -a would defeat the
# build cache mounted below.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -ldflags="-s -w -X github.com/sharifmshaker/cnpg-i-chronicle/internal/cnpgi/metadata.Version=${VERSION}" \
    -o manager ./cmd/manager

FROM registry.access.redhat.com/ubi9/ubi-micro:latest
WORKDIR /
COPY --from=builder /workspace/manager /manager
USER 65532:65532
ENTRYPOINT ["/manager"]
